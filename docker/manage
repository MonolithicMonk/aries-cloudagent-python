#!/bin/bash
export MSYS_NO_PATHCONV=1
# getDockerHost; for details refer to https://github.com/bcgov/DITP-DevOps/tree/main/code/snippets#getdockerhost
. /dev/stdin <<<"$(cat <(curl -s --raw https://raw.githubusercontent.com/bcgov/DITP-DevOps/main/code/snippets/getDockerHost))" 
export DOCKERHOST=$(getDockerHost)
set -e

SCRIPT_HOME="$(cd "$(dirname "$0")" && pwd)"

# =================================================================================================================
# Helper Functions
# -----------------------------------------------------------------------------------------------------------------

function echoError (){
  _msg=${1}
  _red='\e[31m'
  _nc='\e[0m' # No Color
  echo -e "${_red}${_msg}${_nc}"
}

function echoWarning (){
  _msg=${1}
  _yellow='\e[33m'
  _nc='\e[0m' # No Color
  echo -e "${_yellow}${_msg}${_nc}"
}

function echoSuccess (){
  _msg=${1}
  _green='\e[32m'
  _nc='\e[0m' # No Color
  echo -e "${_green}${_msg}${_nc}"
}

function echoInfo (){
  _msg=${1}
  _gray='\e[36m'
  _nc='\e[0m' # No Color
  echo -e "${_gray}${_msg}${_nc}"
}

function toLower() {
  echo $(echo ${@} | tr '[:upper:]' '[:lower:]')
}

# =================================================================================================================
# Usage:
# -----------------------------------------------------------------------------------------------------------------
usage() {
  cat <<-EOF

      Usage: $0 [command] [options]

      Commands:

      start     - Run an agent (calls scripts/run_docker start).
                  $0 start --label my-agent

      up        - Alias for start.

      provision - Provision an agent (calls scripts/run_docker provision).
                  $0 provision --wallet-type askar

      upgrade   - Run the upgrade process (calls scripts/run_docker upgrade).

      demo      - Build the demo docker image and run an integration test or demo.
                  $0 demo --events

      test      - Run unit tests (calls scripts/run_tests).
                  $0 test

      test-all  - Run all unit tests including extras.

      format    - Run code formatting (ruff) via poetry (requires local poetry environment).

EOF
  exit 1
}

# =================================================================================================================
# Environment & Argument Parsing
# -----------------------------------------------------------------------------------------------------------------

configureEnvironment() {
  # Load .env file if it exists
  if [ -f .env ]; then
    echoInfo "Loading environment from .env..."
    while read line; do
      if [[ ! "$line" =~ ^\# ]] && [[ "$line" =~ .*= ]]; then
        export "${line//[$'\r\n']}"
      fi
    done <.env
  fi

  # Process command line arguments for key=value exports
  for arg in "$@"; do
    case "$arg" in
      *=*)
        echoInfo "Exporting env var: ${arg}"
        export "${arg}"
        ;;
    esac
  done
}

getStartupParams() {
  PARAMS=""

  for arg in "$@"; do
    case "$arg" in
    *=*)
      # Skip env var definitions (handled in configureEnvironment)
      ;;
    *)
      PARAMS+=" $arg"
      ;;
    esac
  done

  echo ${PARAMS}
}

# =================================================================================================================
# Main Execution
# -----------------------------------------------------------------------------------------------------------------

pushd ${SCRIPT_HOME} >/dev/null
COMMAND=$(toLower ${1})
shift || COMMAND=usage

case "${COMMAND}" in
start|up)
  echoInfo "Starting ACA-Py container..."
  configureEnvironment "$@"
  ../scripts/run_docker start $(getStartupParams "$@")
  ;;
provision)
  echoInfo "Provisioning ACA-Py wallet..."
  configureEnvironment "$@"
  ../scripts/run_docker provision $(getStartupParams "$@")
  ;;
upgrade)
  echoInfo "Running ACA-Py upgrade..."
  configureEnvironment "$@"
  ../scripts/run_docker upgrade $(getStartupParams "$@")
  ;;
demo)
  echoInfo "Starting Demo..."
  configureEnvironment "$@"
  ../demo/run_demo $(getStartupParams "$@")
  ;;
test)
  echoInfo "Running Unit Tests..."
  configureEnvironment "$@"
  ../scripts/run_tests $(getStartupParams "$@")
  ;;
test-all)
  echoInfo "Running All Unit Tests..."
  configureEnvironment "$@"
  ../scripts/run_tests --all-extras $(getStartupParams "$@")
  ;;
format)
  echoInfo "Formatting code with Ruff..."
  if command -v poetry &> /dev/null; then
    # We assume we are in the docker dir, so we go up to root
    pushd .. >/dev/null
    poetry run ruff format .
    poetry run ruff check --fix .
    popd >/dev/null
    echoSuccess "Formatting complete."
  else
    echoError "Poetry not found. Please install poetry to run local formatting."
    exit 1
  fi
  ;;
*)
  usage
  ;;
esac

popd >/dev/null
